# ---- Aplicacion ----
APP_NAME=ms-usuarios
# Puerto DENTRO del contenedor
APP_PORT=8000
# Puerto publicado en la VM de produccion (rango del curso: 9000-12000)
PUBLISHED_PORT=9006
APP_ENV=development
LOG_LEVEL=info

# ---- Base de datos PostgreSQL ----
# Base propia, separada de la de ms-residentes.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=condominio_usuarios
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---- Autenticacion ----
# IMPORTANTE: este secreto debe ser EL MISMO en todos los microservicios que
# verifican tokens (ms-residentes, ms-pagos, ms-incidencias...). Aqui se firman;
# alla se verifican, sin llamadas HTTP.
# Generar con: openssl rand -hex 32   -- NUNCA commitear el valor real
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
