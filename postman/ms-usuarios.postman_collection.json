{
  "info": {
    "name": "ms-usuarios | CS2032 Condominios",
    "description": "Microservicio de cuentas: register, login y administracion de usuarios.\nEs el unico que EMITE tokens; los demas microservicios los verifican con\nel mismo JWT_SECRET, sin llamarlo.\n\nCOMO USARLA\n1. Corre '1. Auth / Login (admin)': el token se guarda solo en {{token}}.\n2. Ese mismo token sirve tambien en ms-residentes (puerto 9001).\n\nUsuarios de prueba (password: condominio123):\n  admin@condominio.com     -> ADMIN\n  lucia.vargas@example.com -> RESIDENTE",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:9006",
      "description": "Cambiar por http://<ip-vm-produccion>:9006 al desplegar"
    },
    {
      "key": "token",
      "value": "",
      "description": "Lo llena solo el request de login"
    },
    {
      "key": "password_demo",
      "value": "condominio123"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Comprueba la API y que PostgreSQL responda."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "EMPEZAR POR ACA. Guarda el token en {{token}} y registra la sesion en la tabla `sesiones`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@condominio.com\",\n  \"password\": \"{{password_demo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token para que el resto de los requests queden autenticados.",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().access_token);",
                  "}",
                  "pm.test('Login exitoso', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve access_token', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('access_token');",
                  "});",
                  "pm.test('NO expone el password_hash', function () {",
                  "    pm.expect(JSON.stringify(pm.response.json())).to.not.include('password_hash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (residente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login con un usuario de rol RESIDENTE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lucia.vargas@example.com\",\n  \"password\": \"{{password_demo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token para que el resto de los requests queden autenticados.",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().access_token);",
                  "}",
                  "pm.test('Login exitoso', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve access_token', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('access_token');",
                  "});",
                  "pm.test('NO expone el password_hash', function () {",
                  "    pm.expect(JSON.stringify(pm.response.json())).to.not.include('password_hash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea una cuenta y devuelve el token directo. residente_id es un id logico de ms-residentes: no se valida.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo.vecino@example.com\",\n  \"password\": \"micontrasena123\",\n  \"residente_id\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token para que el resto de los requests queden autenticados.",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().access_token);",
                  "}",
                  "pm.test('Login exitoso', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve access_token', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('access_token');",
                  "});",
                  "pm.test('NO expone el password_hash', function () {",
                  "    pm.expect(JSON.stringify(pm.response.json())).to.not.include('password_hash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (quien soy)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Devuelve la cuenta duena del token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Requiere token. La respuesta NO trae password_hash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Requiere rol ADMIN.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"portero@condominio.com\",\n  \"password\": \"portero12345\",\n  \"residente_id\": null,\n  \"rol\": \"RESIDENTE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar usuario 4",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/4",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "4"
              ]
            },
            "description": "Requiere rol ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
